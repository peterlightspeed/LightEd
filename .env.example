# =========================================================
# LightEd — Environment Variables (copy to .env and fill in)
# =========================================================

# ---------- General ----------
APP_ENV=development
APP_NAME=LightEd
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
LOG_LEVEL=INFO

# ---------- Frontend (apps/web) ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=LightEd

# ---------- Backend (apps/api) ----------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma separated)
BACKEND_CORS_ORIGINS=http://localhost:3000

# ---------- Database (PostgreSQL) ----------
POSTGRES_USER=lighted
POSTGRES_PASSWORD=lighted
POSTGRES_DB=lighted
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://lighted:lighted@localhost:5432/lighted

# ---------- Cache / Queue (optional) ----------
REDIS_URL=redis://localhost:6379/0

# ---------- AI / ML (Python) ----------
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=text-embedding-004
AI_DATA_DIR=./ai/data
VECTOR_STORE=faiss

# ---------- Deployment ----------
RENDER_API_KEY=
VERCEL_TOKEN=
