# Copy to .env.local — Next.js reads this at boot, so restart `npm run dev` after editing.

# Base URL of the FastAPI backend. No trailing slash.
# Local:      http://localhost:8000
# Production: https://your-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Shown in a few UI labels. Optional.
NEXT_PUBLIC_APP_NAME=LightEd

# Only needed once Google login is wired up (see GUIDE.md section 7).
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
